# ------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env.
# After the credential leak, use a NEWLY ROTATED MongoDB password here.
# ------------------------------------------------------------------

# MongoDB Atlas connection string (rotate the password first!)
MONGODB_URI=mongodb+srv://<user>:<new-password>@<cluster>.mongodb.net/?appName=Cluster0

# Database / collection names
MONGODB_DB=yellowpages_db
MONGODB_COLLECTION=businesses

# Grafana admin password (used by the monitoring stack)
GRAFANA_ADMIN_PASSWORD=change-me
